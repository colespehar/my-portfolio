# Copy to .env and fill in.
#
# Formspree form ID for the contact form. Create a form at
# https://formspree.io, then copy the ID from the endpoint it gives you:
#   https://formspree.io/f/xyzabcd   ->   VITE_FORMSPREE_ID=xyzabcd
#
# Anything prefixed VITE_ is inlined into the client bundle and is therefore
# public. That is fine for a Formspree ID (it ships in the page HTML by
# design) but never put a real secret behind a VITE_ prefix.
#
# If this is unset the contact form renders a mailto link instead, so
# messages are never silently dropped.
VITE_FORMSPREE_ID=
